# Google Gemini API key for L3 adjudication and embeddings
GEMINI_API_KEY=

# Postgres database connection string (e.g. postgresql://postgres:postgres@localhost:5432/culprit)
CULPRIT_DATABASE_URL=

# Redis connection string (e.g. redis://localhost:6379/0)
CULPRIT_REDIS_URL=

# Setting this turns on database-gated tests; leaving it set with services down hangs the suite
CULPRIT_TEST_DSN=
